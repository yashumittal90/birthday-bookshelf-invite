# Copy this file to .env and fill in your values before running locally.
# Never commit .env — it is listed in .gitignore.

# Turso / LibSQL — create a free DB at https://turso.tech
TURSO_DATABASE_URL=libsql://demo-birthday-invite-<your-turso-username>.aws-us-east-1.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Admin panel password — set any strong random string
ADMIN_KEY=change-me-to-a-strong-random-string
